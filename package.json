{
  "name": "yoga-tribu",
  "type": "module",
  "version": "1.0.0",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "test:consent": "astro build && node --test --test-concurrency=1 'tests/*.test.mjs'",
