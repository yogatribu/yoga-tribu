    "@astrojs/sitemap": "3.1.0",
    "@astrojs/tailwind": "^5.1.0",
    "@vercel/speed-insights": "^2.0.0",
    "astro": "^4.16.0",
    "sharp": "^0.35.1",
    "tailwindcss": "^3.4.0"
  },
  "devDependencies": {
    "playwright": "^1.60.0"
  }
}
