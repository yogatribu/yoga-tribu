# Copia questo file in .env.local e metti le chiavi vere (mai committare .env.local).
# Supabase: Project Settings > API, nel pannello del progetto creato su supabase.com (regione UE).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Resend: la chiave si usa solo lato server (funzioni pianificate), non in questo file del client.
# La mettiamo qui per ricordarci che serve, quando arriviamo alle email.
RESEND_API_KEY=
