---
import BaseLayout from '../layouts/BaseLayout.astro';
import MapLink from '../components/ui/MapLink.astro';
import Button from '../components/ui/Button.astro';
import CTAFinal from '../components/content/CTAFinal.astro';
import Section from '../components/ui/Section.astro';
import Container from '../components/ui/Container.astro';
import Tag from '../components/ui/Tag.astro';
import Heading from '../components/ui/Heading.astro';
import Divider from '../components/ui/Divider.astro';

---

<BaseLayout
  title="Contatti · Yoga Tribù"
  description="Contatta Yoga Tribù a Bassano del Grappa. Scrivici su WhatsApp per informazioni su lezioni, abbonamenti o per venire a trovarci."
  schemaJsonLd={{
    "@context": "https://schema.org",
    "@type": "YogaStudio",
    "name": "Yoga Tribù",
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "Via Giuseppe Mazzini 1",
      "addressLocality": "San Giuseppe",
      "addressRegion": "VI",
      "postalCode": "36022",
      "addressCountry": "IT"
    },
    "telephone": "+393287675966",
    "url": "https://yogatribu.it",
    "openingHours": ["Mo 07:00-21:00", "Tu 08:45-20:30", "We 07:30-21:00", "Th 13:00-20:30", "Fr 07:00-08:30", "Sa 08:30-12:00", "Su 17:30-19:00"]
  }}
>
  <!-- Hero -->
  <Section background="default" size="compact" class="!pt-16 !pb-12 md:!pt-24 md:!pb-16">
    <Container size="narrow" class="text-center pt-6">
      <Tag class="mb-5">Contatti</Tag>
      <Heading level={1} class="mb-5">
        Vieni a trovarci.<br/>O scrivici prima.
      </Heading>
      <p class="text-text-secondary text-base leading-relaxed max-w-[500px] mx-auto">
        Il modo più veloce è WhatsApp. Per domande, informazioni sulle lezioni, o semplicemente per capire se Yoga Tribù fa per te.
      </p>
    </Container>
  </Section>

  <!-- Contatti principali + mappa -->
  <Section background="alt">
    <Container>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-16 items-start">
        <!-- Info contatto -->
        <div>
          <Tag class="mb-8">Come contattarci</Tag>

          <!-- WhatsApp · principale -->
          <div class="mb-10">
            <p class="text-[11px] font-semibold uppercase tracking-[0.1em] text-[#9c9a66] mb-3">WhatsApp (preferito)</p>
            <a
              href="https://wa.me/393287675966"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-3 group"
            >
              <div class="w-10 h-10 rounded-full bg-[#25D366]/10 border border-[#25D366]/30 flex items-center justify-center flex-shrink-0">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="#25D366">
                  <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
                </svg>
              </div>
              <div>
                <p class="text-text-main font-medium group-hover:text-primary transition-colors">+39 328 767 5966</p>
              </div>
            </a>
          </div>

          <Divider class="mb-8" />

          <!-- Email -->
          <div class="mb-10">
            <p class="text-[11px] font-semibold uppercase tracking-[0.1em] text-[#9c9a66] mb-3">Email</p>
            <a
              href="mailto:info@yogatribu.it"
              class="inline-flex items-center gap-3 group"
            >
              <div class="w-10 h-10 rounded-full border border-border flex items-center justify-center flex-shrink-0">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#9c9a66" stroke-width="1.5">
                  <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
                  <polyline points="22,6 12,13 2,6"/>
                </svg>
              </div>
              <div>
                <p class="text-text-main font-medium group-hover:text-primary transition-colors">info@yogatribu.it</p>
                <p class="text-tiny text-text-secondary">Per richieste più articolate</p>
              </div>
            </a>
          </div>

          <Divider class="mb-8" />

          <!-- Indirizzo -->
          <div class="mb-10">
            <p class="text-[11px] font-semibold uppercase tracking-[0.1em] text-[#9c9a66] mb-3">Dove siamo</p>
            <div class="flex items-start gap-3">
              <div class="w-10 h-10 rounded-full border border-border flex items-center justify-center flex-shrink-0 mt-0.5">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#9c9a66" stroke-width="1.5">
                  <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/>
                  <circle cx="12" cy="10" r="3"/>
                </svg>
              </div>
              <div>
                <p class="text-text-main font-medium">Via Giuseppe Mazzini 1</p>
                <p class="text-text-secondary text-sm">36022 San Giuseppe (VI)</p>
                <MapLink address="Yoga Tribù, Via Giuseppe Mazzini 1, 36022 San Giuseppe (VI)" class="mt-1">
                  Apri in mappe
                </MapLink>
              </div>
            </div>
          </div>

        </div>

        <!-- Mappa + form -->
        <div class="space-y-10">
          <!-- Placeholder mappa -->
          <div>
            <p class="text-[11px] font-semibold uppercase tracking-[0.1em] text-[#9c9a66] mb-4">Come arrivare</p>
            <div class="aspect-[4/3] rounded-[18px] overflow-hidden">
              <iframe
                src="https://maps.google.com/maps?q=Yoga%20Trib%C3%B9%2C%20Via%20Giuseppe%20Mazzini%201%2C%2036022%20San%20Giuseppe%20(VI)&z=16&output=embed"
                width="100%"
                height="100%"
                style="border: 0; display: block;"
                allowfullscreen
                loading="lazy"
                referrerpolicy="no-referrer-when-downgrade"
                title="Yoga Tribù su Google Maps"
              ></iframe>
            </div>
            <div class="mt-4 flex items-center justify-between">
              <p class="text-sm text-text-secondary">Via Giuseppe Mazzini 1, 36022 San Giuseppe (VI)</p>
              <MapLink address="Yoga Tribù, Via Giuseppe Mazzini 1, 36022 San Giuseppe (VI)">
                Apri in mappe
              </MapLink>
            </div>
          </div>

          <!-- Box WhatsApp -->
          <div class="bg-white border border-[#e8e4df] rounded-[18px] p-7">
            <p class="text-[11px] uppercase tracking-[0.1em] text-[#9c9a66] mb-4">SCRIVI SU WHATSAPP</p>
            <p class="text-base text-[#6b6b6b] leading-[1.6] mb-6">Il modo più veloce per parlare con noi. Ti rispondiamo entro poche ore.</p>
            <div class="flex justify-center">
              <Button variant="primary" size="md" href="https://wa.me/393287675966?text=Ciao%2C%20vorrei%20sapere%20di%20più%20su%20Yoga%20Tribù" external={true}>
                Apri WhatsApp
              </Button>
            </div>
          </div>
        </div>
      </div>
    </Container>
  </Section>

  <!-- Canali social -->
  <Section background="default" size="compact">
    <Container>
      <div class="flex flex-col md:flex-row items-center justify-between gap-8">
        <div>
          <p class="text-[11px] font-semibold uppercase tracking-[0.1em] text-[#9c9a66] mb-4">SEGUICI</p>
          <div class="flex gap-6 flex-wrap">
            <a
              href="https://instagram.com/yoga__tribu"
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center gap-2 text-sm text-text-secondary hover:text-primary transition-colors"
            >
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                <rect x="2" y="2" width="20" height="20" rx="5" ry="5"/>
                <circle cx="12" cy="12" r="4"/>
                <circle cx="17.5" cy="6.5" r="0.5" fill="currentColor"/>
              </svg>
              @yoga__tribu
            </a>
            <a
              href="https://www.facebook.com/people/Yoga-Trib%C3%B9/100028284085474/"
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center gap-2 text-sm text-text-secondary hover:text-primary transition-colors"
            >
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/>
              </svg>
              Yoga Tribù
            </a>
          </div>
          <p class="text-sm text-text-secondary mt-3">Storie dello studio, contenuti utili, vita di tribù.</p>
        </div>
        <p class="text-sm text-text-secondary">
          P.IVA 04505320244
        </p>
      </div>
    </Container>
  </Section>

  <!-- CTA finale -->
  <CTAFinal
    headline="La risposta più rapida è su WhatsApp."
    subtitle="Scrivici su WhatsApp, ti rispondiamo entro poche ore."
    ctaLabel="Apri WhatsApp"
    ctaHref="https://wa.me/393287675966?text=Ciao!%20Vorrei%20alcune%20informazioni%20su%20Yoga%20Trib%C3%B9."
  />
</BaseLayout>
