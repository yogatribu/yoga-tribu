---
const href = "https://search.google.com/local/writereview?placeid=ChIJZ2dCAQDbeEcRp3RFb_K-YOw";
---
<html lang="it">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Lascia una recensione — Yoga Tribù</title>
    <style>
      * { margin: 0; padding: 0; box-sizing: border-box; }
      body {
        min-height: 100dvh;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        background: #f3efe4;
        font-family: -apple-system, sans-serif;
        padding: 32px 24px;
        text-align: center;
      }
      img { height: 72px; margin-bottom: 32px; }
      h1 { font-size: 1.5rem; color: #2a2a2a; margin-bottom: 12px; font-weight: 500; }
      p { color: #6b6a5c; font-size: 1rem; line-height: 1.6; margin-bottom: 40px; max-width: 320px; }
      a {
        display: inline-block;
        background: #9c9a66;
        color: #fff;
        text-decoration: none;
        font-size: 1.1rem;
        font-weight: 600;
        padding: 16px 40px;
        border-radius: 50px;
      }
    </style>
  </head>
  <body>
    <img src="/logo/logo-completo-ocra.svg" alt="Yoga Tribù">
    <h1>Lascia una recensione</h1>
    <p>La tua opinione ci aiuta a far conoscere lo studio a chi cerca yoga nella zona.</p>
    <a href={href}>Scrivi su Google</a>
  </body>
</html>
