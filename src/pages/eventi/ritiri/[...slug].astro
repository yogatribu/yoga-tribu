---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Button from '../../../components/ui/Button.astro';
import CTAFinal from '../../../components/content/CTAFinal.astro';
import FAQAccordion from '../../../components/content/FAQAccordion.astro';
import Section from '../../../components/ui/Section.astro';
import Container from '../../../components/ui/Container.astro';
import Tag from '../../../components/ui/Tag.astro';
import Heading from '../../../components/ui/Heading.astro';
import Divider from '../../../components/ui/Divider.astro';
import LinkApple from '../../../components/ui/LinkApple.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const ritiri = await getCollection('ritiri');
  return ritiri.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();
const r = entry.data;

const postiRimasti = r.posti_disponibili;
const esaurito = postiRimasti === 0;
const scarsita = postiRimasti <= 3 && postiRimasti > 0;

function formatData(dataStr: string) {
  return new Date(dataStr).toLocaleDateString('it-IT', { day: 'numeric', month: 'long', year: 'numeric' });
}

function durataGiorni(inizio: string, fine: string) {
  const ms = new Date(fine).getTime() - new Date(inizio).getTime();
  return Math.round(ms / (1000 * 60 * 60 * 24)) + 1;
}

const eventSchema = {
  "@context": "https://schema.org",
  "@type": "Event",
  "name": r.title,
  "description": r.descrizione_breve,
  "startDate": r.date_inizio,
  "endDate": r.date_fine,
  "eventStatus": "https://schema.org/EventScheduled",
  "eventAttendanceMode": "https://schema.org/OfflineEventAttendanceMode",
  "location": { "@type": "Place", "name": r.location },
  "organizer": { "@type": "Organization", "name": "Yoga Tribù", "url": "https://yogatribu.it" },
  "offers": {
    "@type": "Offer",
    "price": String(r.prezzo),
    "priceCurrency": "EUR",
    "availability": esaurito ? "https://schema.org/SoldOut" : "https://schema.org/InStock"
  }
};
---

<BaseLayout
  title={`${r.title} · Yoga Tribù`}
  description={r.descrizione_breve}
  ogImage={r.foto_hero}
  schemaJsonLd={eventSchema}
>
  <!-- Hero -->
  <div
    data-hero
    class="relative flex items-end overflow-hidden bg-[#1a1a1a]"
    style="min-height: 80vh;"
  >
    <img
      src={r.foto_hero}
      alt={r.foto_hero_alt ?? r.title}
      class="absolute inset-0 w-full h-full object-cover opacity-65"
      loading="eager"
    />
    <div class="absolute inset-0" style="background: linear-gradient(to top, rgba(0,0,0,0.8) 0%, rgba(0,0,0,0.2) 60%, transparent 100%);"></div>
    <div class="relative container-default pb-16 pt-32">
      <p class="text-[12px] font-semibold uppercase tracking-[0.1em] text-white/70 mb-4">Ritiro · Yoga Tribù</p>
      <h1 class="font-serif text-display-mobile md:text-display text-white leading-tight max-w-3xl mb-4">
        {r.title}
      </h1>
      <p class="text-white/80 text-base max-w-xl leading-relaxed mb-8">
        {r.descrizione_breve}
      </p>
      <div class="flex flex-wrap gap-6 mb-8">
        <div>
          <p class="text-[11px] font-semibold uppercase tracking-[0.1em] text-white/50 mb-1">Date</p>
          <p class="text-white text-sm">{formatData(r.date_inizio)} – {formatData(r.date_fine)}</p>
        </div>
        <div>
          <p class="text-[11px] font-semibold uppercase tracking-[0.1em] text-white/50 mb-1">Durata</p>
          <p class="text-white text-sm">{durataGiorni(r.date_inizio, r.date_fine)} giorni</p>
        </div>
        <div>
          <p class="text-[11px] font-semibold uppercase tracking-[0.1em] text-white/50 mb-1">Luogo</p>
          <p class="text-white text-sm">{r.location}</p>
        </div>
      </div>
      {esaurito ? (
        <Button
          variant="secondary-dark" size="lg" external={true}
          href={`https://wa.me/393287675966?text=${encodeURIComponent(r.wa_testo ?? `Ciao! Il ritiro "${r.title}" è esaurito — posso essere messo in lista d'attesa?`)}`}
        >
          Lista d'attesa
        </Button>
      ) : (
        <Button
          variant="secondary-dark" size="lg" external={true}
          href={`https://wa.me/393287675966?text=${encodeURIComponent(r.wa_testo ?? `Ciao! Sono interessato al ritiro "${r.title}".`)}`}
        >
          {scarsita ? `Prenota, rimangono ${postiRimasti} posti` : 'Prenota il tuo posto'}
        </Button>
      )}
    </div>
  </div>

  <!-- Dettagli rapidi -->
  <Section background="alt" size="compact">
    <Container>
      <div class="grid grid-cols-2 md:grid-cols-4 gap-6 md:gap-10">
        <div>
          <p class="text-[11px] font-semibold uppercase tracking-[0.1em] text-[#9c9a66] mb-2">Insegnanti</p>
          <p class="text-text-main text-sm font-medium">{r.insegnanti.join(' · ')}</p>
        </div>
        <div>
          <p class="text-[11px] font-semibold uppercase tracking-[0.1em] text-[#9c9a66] mb-2">Posti totali</p>
          <p class="text-text-main text-sm font-medium">{r.posti_totali} persone</p>
        </div>
        <div>
          <p class="text-[11px] font-semibold uppercase tracking-[0.1em] text-[#9c9a66] mb-2">Posti disponibili</p>
          <p class={`text-sm font-medium ${esaurito ? 'text-text-secondary' : scarsita ? 'text-[#c95a4a]' : 'text-text-main'}`}>
            {esaurito ? 'Esauriti' : `${postiRimasti} / ${r.posti_totali}`}
          </p>
        </div>
        <div>
          <p class="text-[11px] font-semibold uppercase tracking-[0.1em] text-[#9c9a66] mb-2">Quota di partecipazione</p>
          <p class="text-text-main text-sm font-medium">€{r.prezzo}</p>
        </div>
      </div>
    </Container>
  </Section>

  <!-- Layout editoriale a due colonne -->
  <Section background="default">
    <Container>
      <div class="grid grid-cols-1 md:grid-cols-[1fr_360px] gap-16 items-start">

        <!-- ── Colonna principale ────────────────────────── -->
        <div>

          {/* a) Primo paragrafo descrittivo */}
          {r.descrizione && r.descrizione[0] && (
            <Fragment>
              <p class="text-[11px] font-semibold uppercase tracking-[0.1em] text-[#9c9a66] mb-2">Il ritiro</p>
              <h2 class="font-serif text-h2-mobile md:text-h2 text-[#2a2a2a] mb-6" style="font-family:'New York',serif;">Un'esperienza fuori dall'ordinario.</h2>
              <p class="text-base text-[#2a2a2a] leading-[1.7] mb-6 max-w-[620px]">
                {r.descrizione[0]}
              </p>
            </Fragment>
          )}

          {/* b) Foto grande */}
          <div class="my-10">
            <img
              src={r.foto_principale}
              alt={`${r.title}`}
              class="w-full h-[400px] object-cover rounded-[22px]"
              loading="lazy"
            />
          </div>

          {/* c) Paragrafi rimanenti */}
          {r.descrizione && r.descrizione.slice(1).map((p: string) => (
            <p class="text-base text-[#2a2a2a] leading-[1.7] mb-6 max-w-[620px]">{p}</p>
          ))}

          {/* d) Foto affiancata + testo */}
          {(r.testo_affiancato || r.foto_affiancata) && (
            <div class="grid grid-cols-1 md:grid-cols-2 gap-8 my-10 items-center">
              {r.testo_affiancato && (
                <p class="text-base text-[#2a2a2a] leading-relaxed">{r.testo_affiancato}</p>
              )}
              <img
                src={r.foto_affiancata}
                alt={`${r.title} — dettaglio`}
                class="w-full h-[280px] object-cover rounded-[18px]"
                loading="lazy"
              />
            </div>
          )}

          {/* e) Programma */}
          {r.programma && r.programma.length > 0 && (
            <div class="mt-12">
              <p class="text-[11px] font-semibold uppercase tracking-[0.1em] text-[#9c9a66] mb-2">Programma</p>
              <h2 class="font-serif text-h2-mobile md:text-h2 text-[#2a2a2a] mb-6" style="font-family:'New York',serif;">Giorno per giorno.</h2>
              <div class="space-y-3">
                {r.programma.map((giorno: { giorno: string; attivita: { ora: string; cosa: string }[] }) => (
                  <div class="bg-white border border-[#e8e4df] rounded-[18px] px-6 py-5 shadow-[0_4px_20px_rgba(0,0,0,0.04)]">
                    <p class="text-[11px] font-semibold uppercase tracking-[0.1em] text-[#9c9a66] mb-3">{giorno.giorno}</p>
                    <ul class="space-y-1.5">
                      {giorno.attivita.map((a: { ora: string; cosa: string }) => (
                        <li class="flex gap-3 text-sm">
                          <span class="text-[#9c9a66] font-medium min-w-[56px] flex-shrink-0">{a.ora}</span>
                          <span class="text-[#2a2a2a]">{a.cosa}</span>
                        </li>
                      ))}
                    </ul>
                  </div>
                ))}
              </div>
              <p class="text-sm text-[#9b9b9b] italic mt-4">
                Gli orari potranno subire variazioni in base agli orari di arrivo dei partecipanti.
              </p>
            </div>
          )}

          {/* foto griglia 2 colonne dopo programma */}
          {r.foto_post_programma && r.foto_post_programma.length > 0 && (
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mt-10">
              {r.foto_post_programma.map((src: string) => (
                <img
                  src={src}
                  alt={r.struttura_titolo ?? r.title}
                  class="w-full h-[280px] object-cover rounded-[18px]"
                  loading="lazy"
                />
              ))}
            </div>
          )}

          {/* f) Cosa include / cosa è escluso */}
          {(r.incluso || r.escluso) && (
            <div class="mt-12">
              {r.incluso && r.incluso.length > 0 && (
                <div class="mb-8">
                  <p class="text-[11px] font-semibold uppercase tracking-[0.1em] text-[#9c9a66] mb-2">Cosa include la quota</p>
                  <h2 class="font-serif text-h2-mobile md:text-h2 text-[#2a2a2a] mb-6" style="font-family:'New York',serif;">La quota comprende.</h2>
                  <ul class="space-y-2">
                    {r.incluso.map((item: string) => (
                      <li class="flex gap-3 text-sm text-[#2a2a2a]">
                        <span class="text-[#9c9a66] flex-shrink-0">·</span>{item}
                      </li>
                    ))}
                  </ul>
                </div>
              )}
              {r.escluso && r.escluso.length > 0 && (
                <div>
                  <p class="text-[11px] font-semibold uppercase tracking-[0.1em] text-[#9c9a66] mb-4">Non include</p>
                  <ul class="space-y-2">
                    {r.escluso.map((item: string) => (
                      <li class="flex gap-3 text-sm text-[#2a2a2a]">
                        <span class="text-[#9c9a66] flex-shrink-0">·</span>{item}
                      </li>
                    ))}
                  </ul>
                </div>
              )}
            </div>
          )}

        </div>

        <!-- ── Sidebar ─────────────────────────────────── -->
        <div class="sticky top-24">
          <div class="bg-background-alt border border-border rounded-[22px] p-6 mb-6">
            <div class="flex items-center justify-between mb-5">
              <p class="font-serif text-[32px] text-text-main">€{r.prezzo}</p>
              {scarsita && (
                <span class="text-[11px] font-semibold uppercase tracking-[0.1em] text-white bg-[#c95a4a] px-3 py-1 rounded-full">
                  Ultimi {postiRimasti}
                </span>
              )}
              {esaurito && (
                <span class="bg-[#2a2a2a] text-white text-[11px] font-semibold uppercase tracking-[0.1em] px-3 py-1 rounded-full">
                  Sold out
                </span>
              )}
            </div>
            <Divider class="mb-5" />
            <div class="space-y-3 text-sm mb-6">
              <div class="flex justify-between gap-4">
                <span class="text-text-secondary">Date</span>
                <span class="text-text-main text-right">{formatData(r.date_inizio)}<br/>{formatData(r.date_fine)}</span>
              </div>
              <div class="flex justify-between gap-4">
                <span class="text-text-secondary">Durata</span>
                <span class="text-text-main">{durataGiorni(r.date_inizio, r.date_fine)} giorni</span>
              </div>
              <div class="flex justify-between gap-4">
                <span class="text-text-secondary">Luogo</span>
                <span class="text-text-main text-right">{r.location}</span>
              </div>
              <div class="flex justify-between gap-4">
                <span class="text-text-secondary">Insegnanti</span>
                <span class="text-text-main text-right">{r.insegnanti.join(', ')}</span>
              </div>
            </div>
            <div class="text-center">
              {esaurito ? (
                <Button
                  variant="primary" size="md" external={true}
                  href={`https://wa.me/393287675966?text=${encodeURIComponent(r.wa_testo ?? `Ciao! Il ritiro "${r.title}" è esaurito — posso essere messo in lista d'attesa?`)}`}
                >
                  Lista d'attesa
                </Button>
              ) : (
                <Button
                  variant="primary" size="md" external={true}
                  href={`https://wa.me/393287675966?text=${encodeURIComponent(r.wa_testo ?? `Ciao! Sono interessato al ritiro "${r.title}" — vorrei prenotare il mio posto.`)}`}
                >
                  Prenota su WhatsApp
                </Button>
              )}
            </div>
          </div>
        </div>

      </div>
    </Container>
  </Section>

  <!-- Sezione Location -->
  {(r.struttura_titolo || r.struttura_testo) && (
    <Section background="alt">
      <Container>
        <p class="text-[11px] font-semibold uppercase tracking-[0.1em] text-[#9c9a66] mb-4">La struttura</p>
        {r.struttura_titolo && (
          <h2 class="font-serif text-h2-mobile md:text-h2 text-text-main mb-6" style="font-family:'New York',serif;">
            {r.struttura_titolo}
          </h2>
        )}
        {r.struttura_testo && (
          <p class="text-base text-[#2a2a2a] leading-[1.7] max-w-[700px] mb-4">{r.struttura_testo}</p>
        )}
        {r.struttura_link_url && r.struttura_link_label && (
          <LinkApple href={r.struttura_link_url} target="_blank" tone="ocra">
            {r.struttura_link_label}
          </LinkApple>
        )}
        {r.foto_post_struttura && (
          <img
            src={r.foto_post_struttura}
            alt={r.foto_post_struttura_alt ?? r.struttura_titolo ?? r.title}
            class="w-full h-[380px] object-cover rounded-[22px] mt-10"
            loading="lazy"
          />
        )}
      </Container>
    </Section>
  )}

  <!-- CTA finale -->
  <CTAFinal
    headline={esaurito ? 'I posti sono esauriti.' : 'Pronto a prenotare?'}
    subtitle={esaurito
      ? 'Scrivici per essere inserito in lista d\'attesa.'
      : 'La prenotazione si fa su WhatsApp in meno di un minuto.'}
    ctaLabel={esaurito ? 'Lista d\'attesa su WhatsApp' : 'Prenota su WhatsApp'}
    ctaHref={`https://wa.me/393287675966?text=${encodeURIComponent(r.wa_testo ?? (esaurito ? `Ciao! Il ritiro "${r.title}" è esaurito — lista d'attesa?` : `Voglio prenotare il ritiro "${r.title}".`))}`}
    linkLabel="Vedi tutti gli eventi"
    linkHref="/eventi"
  />
</BaseLayout>
