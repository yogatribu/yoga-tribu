---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Button from '../../components/ui/Button.astro';

const waHref = "https://wa.me/393287675966?text=Ciao!%20Vorrei%20essere%20avvisato%2Fa%20quando%20riparte%20l%27Estate%20in%20Villa%20nel%202027.";

// Data indicativa (non ancora ufficiale) — aggiornare qui appena confermata.
const targetISO = "2027-06-01T00:00:00";
---

<BaseLayout
  title="Estate in Villa · Yoga Tribù"
  description="Yoga all'aperto sotto il portico di una villa a Rosà. Torna nel 2027."
>

  <div
    data-hero
    class="relative flex items-center justify-center overflow-hidden bg-[#1a1a1a] text-center"
    style="min-height: 90vh;"
  >
    <img
      src="/images/estate_in_villa.webp"
      alt="Estate in Villa · Yoga Tribù"
      class="absolute inset-0 w-full h-full object-cover opacity-35"
      loading="eager"
      fetchpriority="high"
    />
    <div class="absolute inset-0" style="background: rgba(0,0,0,0.55);"></div>

    <div class="relative container-default py-24">
      <p class="text-[12px] font-semibold uppercase tracking-[0.1em] text-white/70 mb-6">Yoga Tribù · Estate in Villa</p>
      <h1 class="font-serif text-display-mobile md:text-display text-white leading-tight mb-4" style="font-family:'New York',serif;">
        Torna nel 2027.
      </h1>
      <p class="text-white/75 text-base md:text-lg max-w-md mx-auto leading-relaxed mb-14">
        Yoga all'aperto, sotto il portico di una villa a Rosà.
      </p>

      <div id="countdown" class="flex items-start justify-center gap-6 md:gap-12 mb-14">
        <div class="flex flex-col items-center">
          <span id="cd-days" class="font-serif text-white text-[42px] md:text-[64px] leading-none" style="font-family:'New York',serif;">–</span>
          <span class="text-[11px] uppercase tracking-[0.14em] text-white/60 mt-3">Giorni</span>
        </div>
        <div class="flex flex-col items-center">
          <span id="cd-hours" class="font-serif text-white text-[42px] md:text-[64px] leading-none" style="font-family:'New York',serif;">–</span>
          <span class="text-[11px] uppercase tracking-[0.14em] text-white/60 mt-3">Ore</span>
        </div>
        <div class="flex flex-col items-center">
          <span id="cd-min" class="font-serif text-white text-[42px] md:text-[64px] leading-none" style="font-family:'New York',serif;">–</span>
          <span class="text-[11px] uppercase tracking-[0.14em] text-white/60 mt-3">Minuti</span>
        </div>
        <div class="flex flex-col items-center">
          <span id="cd-sec" class="font-serif text-white text-[42px] md:text-[64px] leading-none" style="font-family:'New York',serif;">–</span>
          <span class="text-[11px] uppercase tracking-[0.14em] text-white/60 mt-3">Secondi</span>
        </div>
      </div>

      <p class="text-white/50 text-[13px] mb-10">Data indicativa · i dettagli arrivano in primavera</p>

      <div class="flex flex-wrap gap-4 items-center justify-center">
        <Button variant="primary" size="lg" href={waHref} external={true}>
          Fatti avvisare per il 2027
        </Button>
        <Button variant="secondary" size="lg" href="/eventi">
          Vedi tutti gli eventi
        </Button>
      </div>
    </div>
  </div>

</BaseLayout>

<script define:vars={{ targetISO }}>
  const target = new Date(targetISO).getTime();
  const elDays = document.getElementById('cd-days');
  const elHours = document.getElementById('cd-hours');
  const elMin = document.getElementById('cd-min');
  const elSec = document.getElementById('cd-sec');
  const pad = (n) => String(n).padStart(2, '0');

  function tick() {
    const diff = target - Date.now();
    if (diff <= 0) {
      elDays.textContent = '0';
      elHours.textContent = '00';
      elMin.textContent = '00';
      elSec.textContent = '00';
      return;
    }
    const days = Math.floor(diff / 86400000);
    const hours = Math.floor((diff % 86400000) / 3600000);
    const min = Math.floor((diff % 3600000) / 60000);
    const sec = Math.floor((diff % 60000) / 1000);
    elDays.textContent = String(days);
    elHours.textContent = pad(hours);
    elMin.textContent = pad(min);
    elSec.textContent = pad(sec);
  }

  tick();
  setInterval(tick, 1000);
</script>
