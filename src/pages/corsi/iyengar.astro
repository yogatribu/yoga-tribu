<script>
  // Segmented control tabs
  const tabs = document.querySelectorAll<HTMLElement>('.tab-btn');
  const panels = document.querySelectorAll<HTMLElement>('.tab-panel');
  const indicator = document.getElementById('iyengar-indicator') as HTMLElement | null;
  const segContainer = document.querySelector<HTMLElement>('.iyengar-seg-container');

  function positionIndicator(activeBtn: HTMLElement) {
    if (!indicator || !segContainer) return;
    const cRect = segContainer.getBoundingClientRect();
    const bRect = activeBtn.getBoundingClientRect();
    indicator.style.width = bRect.width + 'px';
    indicator.style.transform = `translateX(${bRect.left - cRect.left - 4}px)`;
  }

  tabs.forEach(tab => {
    tab.addEventListener('click', () => {
      const id = tab.dataset.tab;
      tabs.forEach(t => {
        const active = t.dataset.tab === id;
        t.setAttribute('aria-selected', active ? 'true' : 'false');
        t.style.color = active ? 'white' : '#6b6b6b';
        if (active) positionIndicator(t);
      });
      panels.forEach(p => {
        p.style.display = p.dataset.panel === id ? '' : 'none';
      });
    });
  });

  requestAnimationFrame(() => {
    const first = document.querySelector<HTMLElement>('.tab-btn[data-tab="livello-1"]');
    if (first) positionIndicator(first);
  });

</script>
