---
// Pagina standalone Linktree · NO header/footer del sito
---

<!doctype html>
<html lang="it">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="robots" content="noindex, nofollow" />
  <title>Yoga Tribù · Link</title>
  <meta name="description" content="Yoga Tribù · Iyengar, Ashtanga e Salute Femminile a Bassano del Grappa." />
  <meta property="og:title" content="Yoga Tribù" />
  <meta property="og:description" content="Studio di Yoga a Bassano del Grappa" />
  <meta property="og:type" content="website" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="preload" href="/fonts/NewYork.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preload" href="/fonts/Inter-latin.woff2" as="font" type="font/woff2" crossorigin />

  <style>
    @font-face {
      font-family: 'New York';
      src: url('/fonts/NewYork.woff2') format('woff2');
      font-weight: 100 900;
      font-style: normal italic;
      font-display: swap;
    }
    @font-face {
      font-family: 'Inter';
      src: url('/fonts/Inter-latin.woff2') format('woff2');
      font-weight: 100 900;
      font-display: swap;
    }

    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      background: #f9f5f0;
      min-height: 100vh;
      font-family: Inter, system-ui, sans-serif;
      -webkit-font-smoothing: antialiased;
      color: #2a2a2a;
    }

    .page {
      max-width: 480px;
      margin: 0 auto;
      padding: 48px 24px 32px;
    }

    /* ─────────────────────────────────────
       HEADER
    ───────────────────────────────────── */
    .header {
      text-align: center;
      margin-bottom: 48px;
    }

    /* TODO: Sostituire con logo Yoga Tribù reale quando disponibile */
    .logo-placeholder {
      width: 80px;
      height: 80px;
      border-radius: 9999px;
      background: #9c9a66;
      display: flex;
      align-items: center;
      justify-content: center;
      margin: 0 auto 20px;
    }
    .logo-placeholder-letter {
      font-family: 'New York', Georgia, serif;
      font-size: 36px;
      font-weight: 500;
      color: white;
      line-height: 1;
      letter-spacing: -0.02em;
    }

    .brand-name {
      font-family: 'New York', 'Cormorant Garamond', 'Playfair Display', 'EB Garamond', Georgia, serif;
      font-size: 30px;
      font-weight: 400;
      letter-spacing: normal;
      color: #2a2a2a;
      text-decoration: none;
      display: block;
      margin-bottom: 12px;
    }
    .brand-name:hover { opacity: 0.8; }

    .brand-tagline {
      font-family: Inter, system-ui, sans-serif;
      font-size: 14px;
      font-weight: 400;
      color: #6b6b6b;
      margin-bottom: 4px;
    }

    .brand-location {
      font-family: Inter, system-ui, sans-serif;
      font-size: 14px;
      font-weight: 400;
      color: #6b6b6b;
    }

    /* ─────────────────────────────────────
       CARD IN EVIDENZA
    ───────────────────────────────────── */
    /* Per cambiare l'evento in evidenza (es. quando arriva un ritiro), modifica solo questa sezione.
       La card può ospitare anche promozioni ritiri, workshop speciali, eventi una tantum. */
    .card-evidenza {
      background: white;
      border-radius: 22px;
      padding: 24px;
      box-shadow: 0 4px 20px rgba(0, 0, 0, 0.06);
      margin-bottom: 16px;
      display: block;
      width: 100%;
      text-decoration: none;
      color: inherit;
      cursor: pointer;
      transition: all 400ms cubic-bezier(0.25, 0.46, 0.45, 0.94);
    }
    .card-evidenza:hover {
      transform: translateY(-4px);
      box-shadow: 0 12px 32px rgba(0, 0, 0, 0.08);
    }

    .card-tag {
      font-family: Inter, system-ui, sans-serif;
      font-size: 11px;
      font-weight: 600;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: #9c9a66;
      margin-bottom: 12px;
    }

    .card-title {
      font-family: 'New York', Georgia, serif;
      font-style: italic;
      font-size: 22px;
      color: #2a2a2a;
      line-height: 1.2;
      margin-bottom: 8px;
    }

    .card-desc {
      font-family: Inter, system-ui, sans-serif;
      font-size: 14px;
      color: #6b6b6b;
      line-height: 1.5;
      margin-bottom: 16px;
    }

    .card-cta {
      font-family: Inter, system-ui, sans-serif;
      font-size: 14px;
      font-weight: 500;
      color: #9c9a66;
      text-decoration: none;
      transition: opacity 150ms ease;
    }
    .card-cta::after { content: ' ›'; }
    .card-cta:hover { opacity: 0.7; }

    /* ─────────────────────────────────────
       LINKS LIST
    ───────────────────────────────────── */
    /* I 4 link sono ottimizzati CRO. Ogni link ha uno scopo distinto:
       1) conversione diretta, 2) auto-segmentazione, 3) esplorazione, 4) cross-sell eventi ricorrenti.
       Non aggiungere link senza valutare l'impatto sulla conversione totale. */
    .links-list {
      display: flex;
      flex-direction: column;
      gap: 12px;
      margin-bottom: 0;
    }

    /* Link base condiviso */
    .link-item {
      display: flex;
      justify-content: space-between;
      align-items: center;
      border-radius: 18px;
      padding: 20px 22px;
      text-decoration: none;
      cursor: pointer;
      transition: all 400ms cubic-bezier(0.25, 0.46, 0.45, 0.94);
    }
    .link-item:active {
      transform: translateY(0) scale(0.99) !important;
    }

    /* ── Link 1: PILLOLA OCRA PIENA (peso visivo massimo) ── */
    .link-primary {
      background: #9c9a66;
      border: 1.5px solid #9c9a66;
      box-shadow: 0 4px 16px rgba(156, 154, 102, 0.2);
    }
    .link-primary:hover {
      background: #8c8a5c;
      border-color: #8c8a5c;
      transform: translateY(-4px);
      box-shadow: 0 12px 32px rgba(0, 0, 0, 0.08);
    }
    .link-primary .link-label {
      font-family: Inter, system-ui, sans-serif;
      font-size: 16px;
      font-weight: 600;
      color: white;
    }
    .link-primary .link-arrow {
      font-size: 20px;
      color: rgba(255, 255, 255, 0.9);
      flex-shrink: 0;
      margin-left: 12px;
      line-height: 1;
    }

    /* ── Links 2-4: BIANCHI PULITI ── */
    .link-secondary {
      background: white;
      border: 1px solid rgba(156, 154, 102, 0.25);
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.03);
    }
    .link-secondary:hover {
      background: #faf6f0;
      border-color: rgba(156, 154, 102, 0.5);
      transform: translateY(-4px);
      box-shadow: 0 12px 32px rgba(0, 0, 0, 0.08);
    }
    .link-secondary .link-label {
      font-family: Inter, system-ui, sans-serif;
      font-size: 15px;
      font-weight: 500;
      color: #2a2a2a;
    }
    .link-secondary .link-arrow {
      font-size: 18px;
      color: #9c9a66;
      flex-shrink: 0;
      margin-left: 12px;
      line-height: 1;
    }

    /* ─────────────────────────────────────
       SOCIAL FOOTER
    ───────────────────────────────────── */
    .social-footer {
      margin-top: 48px;
      padding-top: 32px;
      border-top: 1px solid #e8e4df;
      display: flex;
      justify-content: center;
      gap: 28px;
      margin-bottom: 24px;
    }

    .social-link {
      color: #9c9a66;
      transition: opacity 200ms ease;
      line-height: 0;
      display: block;
    }
    .social-link:hover { opacity: 0.7; }

    .copyright {
      text-align: center;
      font-family: Inter, system-ui, sans-serif;
      font-size: 11px;
      font-weight: 400;
      letter-spacing: 0.02em;
      color: #9b9b9b;
    }

    /* ─────────────────────────────────────
       MOBILE
    ───────────────────────────────────── */
    @media (max-width: 480px) {
      .brand-name { font-size: 24px; }
    }

    /* Scroll reveal · stesso pattern di globals.css ([data-reveal]) */
    [data-reveal] {
      opacity: 0;
      transform: translateY(24px);
      transition: opacity 600ms ease-out, transform 600ms ease-out;
    }
    [data-reveal].revealed {
      opacity: 1;
      transform: translateY(0);
    }

    @media (prefers-reduced-motion: reduce) {
      [data-reveal] { opacity: 1 !important; transform: none !important; transition: none !important; }
    }
  </style>
</head>

<body>
  <div class="page">

    <!-- ── HEADER ── -->
    <header class="header">
      <img src="/logo/icona-ocra.svg" alt="Yoga Tribù" style="height: 80px; width: auto; display: block; margin: 0 auto 24px;" />

