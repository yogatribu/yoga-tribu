---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CTAFinal from '../../components/content/CTAFinal.astro';
import Section from '../../components/ui/Section.astro';
import Container from '../../components/ui/Container.astro';
import Tag from '../../components/ui/Tag.astro';
import Heading from '../../components/ui/Heading.astro';
import Divider from '../../components/ui/Divider.astro';
import Button from '../../components/ui/Button.astro';
---

<BaseLayout
  title="Asia · Teen Yoga · Yoga Tribù"
  description="Insegnante Teen Yoga a Yoga Tribù. Classi dedicate ai ragazzi, progettate per corpo e mente in crescita."
  noindex={true}
>
  <!-- Hero -->
  <div
    data-hero
    class="relative overflow-hidden bg-[#2a2a2a]"
    style="min-height: 60vh;"
  >
    <img
      src="https://images.unsplash.com/photo-1571019613454-1cb2f99b2d8b?w=1600&q=80"
      alt="Teen Yoga — insegnante"
      class="absolute inset-0 w-full h-full object-cover opacity-45"
      loading="eager" fetchpriority="high"
    />
    <div class="absolute inset-0" style="background: linear-gradient(to right, rgba(0,0,0,0.65) 0%, rgba(0,0,0,0.15) 100%);"></div>
    <div class="relative container-default flex items-end" style="min-height: 60vh; padding-bottom: 4rem;">
      <div class="max-w-xl">
        <p class="text-[12px] font-semibold uppercase tracking-[0.1em] text-white/70 mb-4">Insegnante</p>
        <h1 class="font-serif text-display-mobile md:text-display text-white leading-tight mb-3">Asia</h1>
        <p class="text-sm uppercase tracking-[0.1em] text-[#d4b5a0] mb-6">Teen Yoga</p>
        <p class="text-white/80 text-base max-w-md leading-relaxed">
          <!-- TODO: aggiungere contenuto reale -->
        </p>
      </div>
    </div>
  </div>

  <!-- Bio -->
  <Section background="default">
    <Container>
      <div class="grid grid-cols-1 md:grid-cols-[1fr_2fr] gap-16 items-start">
        <!-- Sidebar -->
        <div>
          <div class="aspect-[3/4] rounded-md overflow-hidden mb-8">
            <img
              src="https://images.unsplash.com/photo-1571019613454-1cb2f99b2d8b?w=600&q=80"
              alt="Teen Yoga insegnante"
              class="w-full h-full object-cover"
              loading="lazy"
            />
          </div>
          <p class="text-[12px] font-semibold uppercase tracking-[0.1em] text-[#9c9a66] mb-4">Formazione</p>
          <ul class="space-y-2 mb-8">
            {[
              'Bio in arrivo.',
              'Bio in arrivo.',
              'Bio in arrivo.',
            ].map(c => (
              <li class="text-sm text-text-secondary flex gap-2">
                <span class="text-[#d4b5a0] mt-0.5">·</span>
                <span>{c}</span>
              </li>
            ))}
          </ul>
          <Divider class="mb-6" />
          <Button
            variant="primary"
            size="sm"
            href="https://wa.me/393287675966?text=Ciao!%20Sono%20un%20genitore%20interessato%20al%20Teen%20Yoga."
            external={true}
          >
            Scrivici (per genitori e ragazzi)
          </Button>
        </div>

        <!-- Testo -->
        <div>
          <blockquote class="font-serif italic text-[22px] md:text-[28px] text-text-secondary leading-[1.4] mb-10 max-w-xl">
            "Bio in arrivo."
          </blockquote>
          <Divider class="max-w-[80px] mb-10" />
          <div class="space-y-5 text-base text-text-secondary leading-relaxed">
            <!-- TODO: aggiungere contenuto reale (raccogliere da insegnante) -->
            <!-- TODO: aggiungere contenuto reale (raccogliere da insegnante) -->
            <!-- TODO: aggiungere contenuto reale (raccogliere da insegnante) -->
            <!-- TODO: aggiungere contenuto reale (raccogliere da insegnante) -->
          </div>
        </div>
      </div>
    </Container>
  </Section>

  <!-- La lezione teen -->
  <Section background="alt">
    <Container>
      <Tag class="mb-5">Il mercoledì pomeriggio</Tag>
      <Heading level={2} class="mb-8">Teen Yoga in studio.</Heading>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-12 items-center">
        <div class="space-y-4 text-base text-text-secondary leading-relaxed">
          <p>Ogni mercoledì pomeriggio alle 16:30, per circa un'ora.</p>
          <p>La lezione è pensata per ragazzi dagli 11 ai 17 anni, adattata all'età, al livello e all'energia del gruppo. Non è una versione ridotta dello yoga adulti: è una pratica progettata apposta per corpi in crescita.</p>
          <p>I genitori possono assistere alla prima lezione. Dopo, si lascia spazio ai ragazzi.</p>
        </div>
        <div class="bg-background rounded-md p-8">
          <div class="space-y-4">
            <div class="flex justify-between items-center border-b border-border pb-4">
              <span class="text-sm text-text-secondary">Giorno</span>
              <span class="text-sm text-text-main font-medium">Mercoledì</span>
            </div>
            <div class="flex justify-between items-center border-b border-border pb-4">
              <span class="text-sm text-text-secondary">Orario</span>
              <span class="text-sm text-text-main font-mono">16:30</span>
            </div>
            <div class="flex justify-between items-center border-b border-border pb-4">
              <span class="text-sm text-text-secondary">Durata</span>
              <span class="text-sm text-text-main">~60 min</span>
            </div>
            <div class="flex justify-between items-center border-b border-border pb-4">
              <span class="text-sm text-text-secondary">Età</span>
              <span class="text-sm text-text-main">11–17 anni</span>
            </div>
            <div class="flex justify-between items-center">
              <span class="text-sm text-text-secondary">Esperienza richiesta</span>
              <span class="text-sm text-text-main">Nessuna</span>
            </div>
          </div>
        </div>
      </div>
    </Container>
  </Section>

  <!-- CTA -->
  <CTAFinal
    headline="Vuoi portare tuo figlio a provare?"
    subtitle="Scrivici su WhatsApp, ti diciamo tutto quello che c'è da sapere prima della prima lezione."
    ctaLabel="Scrivi ai genitori su WhatsApp"
    ctaHref="https://wa.me/393287675966?text=Ciao!%20Sono%20genitore%20e%20vorrei%20portare%20mio%20figlio%20al%20Teen%20Yoga."
    linkLabel="Scopri il programma Teen"
    linkHref="/corsi/teen-yoga"
  />
</BaseLayout>
