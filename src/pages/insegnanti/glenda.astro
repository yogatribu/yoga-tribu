---
import TeacherLayout from '../../layouts/TeacherLayout.astro';

const lezioni = [
  { giorno: 'Lunedì',    ora: '7:00',  tipo: 'Flessibilità', durata: '~75 min' },
  { giorno: 'Lunedì',    ora: '8:45',  tipo: 'Flessibilità', durata: '~75 min' },
  { giorno: 'Lunedì',    ora: '17:30', tipo: 'Flessibilità', durata: '~75 min' },
  { giorno: 'Lunedì',    ora: '19:00', tipo: 'Flessibilità', durata: '~75 min' },
  { giorno: 'Martedì',   ora: '8:45',  tipo: 'Restorative',            durata: '~75 min' },
  { giorno: 'Martedì',   ora: '13:00', tipo: 'Avanzato · Flessibilità', durata: '~75 min' },
  { giorno: 'Mercoledì', ora: '8:45',  tipo: 'Forza', durata: '~75 min' },
  { giorno: 'Mercoledì', ora: '17:30', tipo: 'Forza', durata: '~75 min' },
  { giorno: 'Mercoledì', ora: '19:00', tipo: 'Forza', durata: '~75 min' },
  { giorno: 'Giovedì',   ora: '8:45',  tipo: 'SOS Dolori', durata: '~75 min' },
  { giorno: 'Giovedì',   ora: '13:00', tipo: 'Avanzato · Forza', durata: '~75 min' },
];

const sezioniStoria = [
  { titolo: 'Come ho incontrato lo yoga', paragrafi: ["Vengo dallo sport, che per me è sempre stato una palestra di vita. Mi ha insegnato che si parte sempre dal corpo, ma che il lavoro vero, prima o poi, si sposta e si consolida nella mente. È con questo spirito che mi sono avvicinata allo yoga: all'inizio cercavo solo un modo per equilibrare e migliorare la mia preparazione sportiva. Non immaginavo dove mi avrebbe portata. Nel giro di qualche anno lo yoga era diventato una priorità, più ancora dello sport stesso. Ho iniziato a praticare ogni giorno, poi a trasmettere quello che imparavo agli amici e agli atleti che allenavo. Finché ho capito che non bastava più: sentivo il bisogno di una formazione seria, che desse fondamento a tutto."] },
  { titolo: 'La formazione',              paragrafi: ["Ho scelto la strada dell'Iyengar Yoga proprio perché è una scuola che non fa sconti: seria, rigorosa, impegnativa. Tre anni di pratica come studente, e altri tre di formazione vera e propria. Un percorso lungo, che mi ha formata in profondità, studiando con Gabriella Giubilaro e David Meloni. Il diploma mi è stato rilasciato da Geeta Iyengar, figlia di B.K.S. Iyengar, il maestro che ha portato questa disciplina in tutto il mondo."] },
  { titolo: 'Perché l\'Iyengar',          paragrafi: ["L'Iyengar Yoga è una pratica profondamente pragmatica. Le posizioni, le asana, si affrontano in modo logico e razionale, senza nulla lasciato al caso. È una disciplina che si declina in molte forme: terapeutica, posturale, dinamica, di forza, di flessibilità. Ed è proprio questo a renderla adatta a chiunque, a qualunque età e con qualunque difficoltà, perché a ogni persona si propone il giusto sforzo, calibrato su di essa."] },
  { titolo: 'Perché Yoga Tribù',          paragrafi: ["Nel 2014 ho aperto una scuola di yoga a Bassano del Grappa, che condividevo con altri insegnanti di pilates e ginnastica. Con il tempo, però, ho cominciato a sentire la necessità di avere uno spazio davvero mio, dove poter dare forma alla mia idea di yoga senza compromessi. Così, nel 2024, ho deciso di fare il passo: è nata Yoga Tribù."] },
  { titolo: 'Il mio approccio',           paragrafi: ["Chi inizia a praticare con me, all'inizio, si sente un po' spaesato. I concetti sono nuovi, i criteri diversi da tutto ciò a cui era abituato. Ma poi, una volta entrati nella logica della pratica, succede qualcosa: il beneficio è così concreto che praticare diventa indispensabile. I dolori migliorano, le parti deboli si rinforzano, quelle rigide si ammorbidiscono. E si scopre quante cose può fare il corpo che prima sembravano impensabili. Chi pratica da tempo cambia perfino il modo di respirare e di muoversi."] },
];

const schema = {
  "@context": "https://schema.org",
  "@type": "Person",
  "name": "Glenda",
  "jobTitle": "Yoga Teacher · Founder",
  "worksFor": { "@type": "Organization", "name": "Yoga Tribù", "url": "https://yogatribu.it" },
  "description": "Fondatrice di Yoga Tribù e insegnante certificata Iyengar e Ashtanga.",
  "knowsAbout": ["Iyengar Yoga", "Ashtanga Yoga"],
};
---

<TeacherLayout
  title="Glenda · Fondatrice e insegnante Iyengar · Yoga Tribù"
  description="Glenda è la fondatrice di Yoga Tribù e insegnante certificata Iyengar e Ashtanga. Da oltre 15 anni insegna con rigore, precisione e profonda cura per ogni allievo."
  schema={schema}
  nome="Glenda"
  ruolo="La fondatrice"
  pratica="Fondatrice · Iyengar Yoga"
  coloreAccento="#9c9a66"
  fotoHero="/images/insegnanti/glenda.webp"
  fotoSidebar="/images/insegnanti/glenda.webp"
  labelFormazione="Certificazioni"
  formazione={[
    'Diploma Iyengar Yoga rilasciato da Geeta Iyengar - RIMYI, Pune (India)',
    'Formata da Gabriella Giubilaro e David Meloni',
    'Percorso completo: 3 anni di pratica + 3 anni di formazione',
    'Specializzata in Iyengar Yoga',
    'Fondatrice di Yoga Tribù',
  ]}
  sezioniStoria={sezioniStoria}
  citazioneBio="Ogni vita è un cammino diverso. E lo yoga è il modo che ognuno trova per percorrerlo."
  introLezioni="Insegno Iyengar Yoga a tutti i livelli. Se non sai da dove iniziare, scrivi su WhatsApp: ti dico io qual è la classe giusta per te."
  lezioni={lezioni}
>
  <div slot="lezioni-content" class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-4 max-w-[1040px] mx-auto text-left">
    {[
      { tag: 'FLESSIBILITÀ', orario: 'Lunedì 7:00' },
      { tag: 'FLESSIBILITÀ', orario: 'Lunedì 8:45' },
      { tag: 'FLESSIBILITÀ', orario: 'Lunedì 17:30' },
      { tag: 'FLESSIBILITÀ', orario: 'Lunedì 19:00' },
      { tag: 'RESTORATIVE', orario: 'Martedì 8:45' },
      { tag: 'AVANZATO · FLESSIBILITÀ', orario: 'Martedì 13:00' },
      { tag: 'FORZA', orario: 'Mercoledì 8:45' },
      { tag: 'FORZA', orario: 'Mercoledì 17:30' },
      { tag: 'FORZA', orario: 'Mercoledì 19:00' },
      { tag: 'SOS DOLORI', orario: 'Giovedì 8:45' },
      { tag: 'AVANZATO · FORZA', orario: 'Giovedì 13:00' },
    ].map(({ tag, orario }) => (
      <div class="bg-white border border-[#e8e4df] rounded-[18px] px-6 py-5 shadow-[0_4px_20px_rgba(0,0,0,0.04)] transition duration-[250ms] ease-[cubic-bezier(0.25,0.46,0.45,0.94)] hover:-translate-y-0.5 hover:shadow-[0_8px_28px_rgba(0,0,0,0.06)] cursor-default" style="min-height: 112px; display: flex; flex-direction: column; gap: 8px;">
        <p class="text-tiny uppercase tracking-widest" style="color: #9c9a66;">{tag}</p>
        <p class="font-serif text-xl text-text-main">{orario}</p>
      </div>
    ))}
  </div>
</TeacherLayout>
