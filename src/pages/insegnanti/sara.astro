---
import TeacherLayout from '../../layouts/TeacherLayout.astro';
import Button from '../../components/ui/Button.astro';


const sezioniStoria = [
  {
    titolo: 'Il percorso',
    paragrafi: [
      "Mi sono laureata in Ostetricia nel 2004 e ho iniziato immediatamente a lavorare con le donne in gravidanza. Quello che mi ha colpito fin dall'inizio non era il momento del parto in sé, era tutto quello che veniva prima e dopo. La preparazione, l'ascolto, la relazione con il proprio corpo che cambia.",
    ],
  },
  {
    titolo: 'La specializzazione',
    paragrafi: [
      "Mi sono poi specializzata in salutofisiologia ostetrica, in riabilitazione pelvi-perineale, e sono formata AIMI in massaggio neonatale e nel metodo De Gasquet.",
      "Offro assistenza a donne in gravidanza, nel parto a domicilio o in accompagnamento in ospedale.",
      "Mi occupo di riabilitazione del pavimento pelvico con donne di tutte le età.",
    ],
  },
  {
    titolo: 'Cosa trovi a Yoga Tribù',
    paragrafi: [
      "A Yoga Tribù propongo quattro percorsi. La ginnastica pelvica, per la riabilitazione e il rinforzo del pavimento pelvico in gravidanza, nel post-parto e per tutte le donne. Il massaggio neonatale, per costruire il legame tra genitore e bambino nei primi mesi di vita.",
      "L'accompagnamento alla nascita, un percorso per coppie e donne che si preparano al parto. E i Cerchi di Cura, uno spazio semplice e accogliente dove prendersi del tempo per sé, tra pratiche leggere e condivisione autentica, insieme ad altre donne.",
    ],
  },
];

const schema = {
  "@context": "https://schema.org",
  "@type": "Person",
  "name": "Sara Zampierin",
  "jobTitle": "Ostetrica · Insegnante Salute Femminile",
  "worksFor": { "@type": "Organization", "name": "Yoga Tribù", "url": "https://yogatribu.it" },
  "description": "Ostetrica e specialista in salutofisiologia ostetrica, riabilitazione pelvi-perineale e massaggio neonatale.",
  "knowsAbout": ["Ginnastica Pelvica", "Massaggio Neonatale", "Accompagnamento alla Nascita", "Riabilitazione Pelvi-perineale"],
};
---

<TeacherLayout
  title="Sara Zampierin · Salute Femminile · Yoga Tribù"
  description="Sara Zampierin è ostetrica e insegnante di Salute Femminile a Yoga Tribù. Ginnastica pelvica, massaggio neonatale, accompagnamento alla nascita."
  schema={schema}
  nome="Sara"
  ruolo="Insegnante"
  pratica="Salute Femminile"
  waNumero="393471098694"
  waTestoCustom="Ciao Sara! Vorrei informazioni sui percorsi di Salute Femminile."
  ctaHeadline="Vuoi iniziare un percorso?"
  ctaSubtitle="I percorsi di Salute Femminile sono personalizzati, con orari e costi dedicati. Scrivimi e troviamo insieme quello giusto per te."
  ctaLabel="Scrivimi su WhatsApp"
  ctaLinkLabel=""
  ctaLinkHref=""
  nascondiDivider={true}
  coloreAccento="#c89797"
  fotoHero="/images/insegnanti/sara.webp"
  fotoSidebar="/images/insegnanti/sara.webp"
  labelFormazione="Formazione e specializzazioni"
  formazione={[
    'Ostetrica dal 2004',
    'Specializzazione in salutofisiologia ostetrica',
    'Formazione AIMI in massaggio neonatale',
    'Formata nel metodo De Gasquet',
    'Esperta in riabilitazione pelvi-perineale',
    'Assistenza al parto, a domicilio o in accompagnamento in ospedale',
  ]}
  sezioniStoria={sezioniStoria}
  filosofiaSinistra={[]}
  filosofiaDestra={[]}
  lezioni={[]}
>
  <div slot="lezioni-content" class="text-center">
    <p class="text-base text-[#6b6b6b] leading-relaxed max-w-[560px] mx-auto mb-6">
      I miei percorsi si organizzano in base al periodo e alle esigenze di ogni donna.
      Ginnastica pelvica, massaggio neonatale, accompagnamento alla nascita e cerchi
      di cura: scrivimi per sapere cosa è attivo al momento e trovare il momento giusto.
    </p>
    <Button
      variant="primary"
      size="md"
      href="https://wa.me/393471098694?text=Ciao%20Sara!%20Vorrei%20sapere%20quali%20percorsi%20sono%20attivi%20al%20momento."
      external={true}
    >
      Scrivimi su WhatsApp
    </Button>
  </div>
</TeacherLayout>
