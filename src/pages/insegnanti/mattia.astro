---
import TeacherLayout from '../../layouts/TeacherLayout.astro';
import { INSEGNANTI_ATTIVI } from '../../config/visibilita.js';

const schema = {
  "@context": "https://schema.org",
  "@type": "Person",
  "name": "Mattia dall'Alba",
  "jobTitle": "Iyengar Yoga Teacher",
  "worksFor": { "@id": "https://www.yogatribu.it/#business" },
  "knowsAbout": ["Iyengar Yoga", "Ritiri di Yoga"],
  "alumniOf": { "@type": "Organization", "name": "Ramamani Iyengar Memorial Yoga Institute, Pune" },
};
---

<TeacherLayout
  title="Mattia · Insegnante Iyengar · Yoga Tribù"
  description="Mattia dall'Alba, insegnante Iyengar Yoga con diploma Level 1 al RIMYI di Pune, formato da David Meloni. Co-conduce ritiri e approfondimenti di Yoga Tribù insieme a Glenda."
  schema={schema}
  noindex={!INSEGNANTI_ATTIVI.includes('mattia')}
  nome="Mattia"
  ruolo="Insegnante"
  pratica="Iyengar Yoga"
  coloreAccento="#9c9a66"
  fotoHero="/images/insegnanti/mattia.webp"
  fotoSidebar="/images/insegnanti/mattia.webp"
  sottotitoloHero="Iyengar Yoga, diploma Level 1 al RIMYI di Pune. Co-conduce i ritiri e gli approfondimenti di Yoga Tribù insieme a Glenda."
  labelFormazione="Certificazioni"
  formazione={[
    'Diploma Iyengar Yoga Level 1 rilasciato da Prashant Iyengar - RIMYI, Pune (India)',
    'Percorso completo: 3 anni di pratica + 3 anni di formazione sotto la guida di David Meloni',
    'Seminari e approfondimenti con Gabriella Giubilaro, Christian Pisano, Barbara Abeles e Usha Devi',
    'Studi a Pune, al RIMYI, con i discendenti di Iyengar',
    'Specializzato in Iyengar Yoga',
  ]}
  citazioneBio="Ogni postura è uno studio approfondito di sé."
  sezioniStoria={[
    {
      titolo: 'Chi è Mattia',
      paragrafi: [
        "Mattia dall'Alba insegna Iyengar Yoga. Ha il diploma di Level 1, rilasciato da Prashant Iyengar al RIMYI di Pune, in India, dopo sei anni di percorso: tre di pratica da studente e tre di formazione, sotto la guida di David Meloni.",
        `È anche il founder di <a href="https://www.pozzodelleternita.it" target="_blank" rel="noopener" class="text-[#9c9a66] underline underline-offset-2">Pozzo dell'Eternità</a>, lo studio di yoga di Colico dove insegna ogni settimana.`,
      ],
    },
    {
      titolo: 'Come ha incontrato lo yoga',
      paragrafi: [
        "Mattia ha cominciato a praticare alla ricerca di una disciplina che lavorasse sul corpo e sulla mente insieme, e ne è rimasto affascinato da subito. Ha iniziato a praticare con regolarità e, poco alla volta, a trasmettere quello che imparava agli amici.",
        "Finché ha sentito il bisogno di una formazione più completa. Da lì è cominciato il percorso di mentorship con David Meloni.",
      ],
    },
    {
      titolo: 'Il suo ruolo a Yoga Tribù',
      paragrafi: [
        "Mattia co-conduce i ritiri e gli approfondimenti della domenica di Yoga Tribù insieme a Glenda: più tempo, più dettaglio, e lo sguardo di un secondo insegnante sulla stessa pratica.",
        "Continua a studiare con regolarità: segue seminari e approfondimenti con altri maestri e torna a Pune per studiare direttamente con i discendenti di Iyengar.",
      ],
    },
    {
      titolo: 'Come insegna',
      paragrafi: [
        "Trasmette gli insegnamenti ricevuti e la sua ricerca con precisione e semplicità, per stimolare la comprensione e la concentrazione di chi pratica.",
      ],
    },
  ]}
  tagLezioni="Ritiri e approfondimenti"
  titoloLezioni="Dove trovarmi."
  introLezioni="Mattia non tiene lezioni regolari in studio. Lo trovi ai ritiri e agli approfondimenti di Yoga Tribù, che co-conduce insieme a Glenda."
  lezioni={[]}
  ctaHeadline="Vuoi vivere un ritiro con noi?"
  ctaLinkLabel="Scopri i prossimi eventi"
  ctaLinkHref="/eventi"
  waTestoCustom="Ciao! Sono interessato ai ritiri e agli approfondimenti di Yoga Tribù con Mattia e Glenda."
>
  <div slot="lezioni-content" class="max-w-[600px] mx-auto text-center">
    <a
      href="/eventi#ritiri"
      class="group block bg-white border border-[#e8e4df] rounded-[22px] px-8 py-8 shadow-[0_4px_20px_rgba(0,0,0,0.04)] transition duration-[250ms] ease-[cubic-bezier(0.25,0.46,0.45,0.94)] hover:-translate-y-0.5 hover:shadow-[0_8px_28px_rgba(0,0,0,0.06)] no-underline"
    >
      <p class="text-[11px] font-semibold uppercase tracking-[0.1em] text-[#9c9a66] mb-3">Prossimi ritiri</p>
      <p class="font-serif text-[28px] text-[#2a2a2a] leading-tight mb-3">Guarda il calendario ritiri</p>
      <p class="text-sm text-text-secondary leading-relaxed">
        I ritiri si tengono durante l'anno in location selezionate. Scopri le date e i dettagli.
      </p>
    </a>
  </div>
</TeacherLayout>
