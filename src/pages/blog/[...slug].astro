---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../../components/ui/Container.astro';
import CTAFinal from '../../components/content/CTAFinal.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const articoli = await getCollection('blog', ({ data }) => data.draft !== true);
  return articoli.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();
const a = entry.data;

function formatData(dataStr: string) {
  return new Date(dataStr).toLocaleDateString('it-IT', {
    day: 'numeric', month: 'long', year: 'numeric',
  });
}

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: a.title,
  description: a.descrizione_breve,
  datePublished: a.data,
  author: { '@type': 'Organization', name: a.autore ?? 'Yoga Tribù' },
  publisher: { '@id': 'https://www.yogatribu.it/#business' },
};

const EYEBROW = 'text-[11px] font-semibold uppercase tracking-[0.1em] text-[#9c9a66]';
---

<BaseLayout
  title={`${a.title} · Blog · Yoga Tribù`}
  description={a.descrizione_breve}
  schemaJsonLd={articleSchema}
>
  <div class="bg-background pt-28 pb-12 md:pt-32 md:pb-14">
    <Container size="narrow">
      <p class={`${EYEBROW} mb-4`}>Blog · {formatData(a.data)}</p>
      <h1 class="font-serif text-h1-mobile md:text-h1 text-text-main leading-tight max-w-3xl mb-4">
        {a.title}
      </h1>
      <p class="text-text-secondary text-lg max-w-xl leading-relaxed">{a.descrizione_breve}</p>
    </Container>
  </div>

  <div class="bg-background">
    <Container size="narrow">
      <div class="prose prose-neutral max-w-none pb-20
        prose-p:text-base prose-p:text-[#2a2a2a] prose-p:leading-[1.7] prose-p:mb-6
        prose-headings:font-serif prose-headings:font-normal prose-headings:text-text-main
        prose-h2:text-[26px] prose-h2:mb-4 prose-h2:mt-10
        prose-em:italic
        prose-a:text-[#9c9a66] prose-a:underline">
        <Content />
      </div>
      <a href="/blog" class="inline-block text-sm text-[#9c9a66] hover:underline mb-16">‹ Tutti gli articoli</a>
    </Container>
  </div>

  <CTAFinal
    headline="Vuoi provare di persona?"
    subtitle="Prima lezione di prova a 10€. In studio."
  />
</BaseLayout>
