---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/ui/Button.astro';
import ScheduleGrid from '../components/content/ScheduleGrid.astro';
import ScheduleMobile from '../components/content/ScheduleMobile.astro';
import ScheduleModal from '../components/content/ScheduleModal.astro';
import ScheduleFilters from '../components/interactive/ScheduleFilters.astro';
import CTAFinal from '../components/content/CTAFinal.astro';
import HowItWorksSteps from '../components/content/HowItWorksSteps.astro';
import Section from '../components/ui/Section.astro';
import Container from '../components/ui/Container.astro';
import Tag from '../components/ui/Tag.astro';
import Heading from '../components/ui/Heading.astro';
import { PRATICHE_ATTIVE } from '../config/visibilita.js';

// Mappa stile interno → slug in visibilita.js
const STILE_TO_SLUG: Record<string, string> = {
  'iyengar': 'iyengar',
  'ashtanga': 'ashtanga',
  'flow': 'vinyasa',
  'teen': 'teen-yoga',
  'donna': 'salute-femminile',
};

const tutteLeLezioni = [
  // LUNEDÌ
  { giorno: 'lun', ora: '7:00',  stile: 'iyengar',  tipo: 'Livello 2', insegnante: 'Glenda', durata: '~75 min' },
  { giorno: 'lun', ora: '8:45',  stile: 'iyengar',  tipo: 'Livello 1', insegnante: 'Glenda', durata: '~75 min' },
  { giorno: 'lun', ora: '18:00', stile: 'iyengar',  tipo: 'Livello 2', insegnante: 'Glenda', durata: '~75 min' },
  { giorno: 'lun', ora: '19:30', stile: 'iyengar',  tipo: 'Livello 2', insegnante: 'Glenda', durata: '~75 min' },
  // MARTEDÌ
  { giorno: 'mar', ora: '8:45',  stile: 'iyengar',  tipo: 'Soft',      insegnante: 'Glenda', durata: '~75 min' },
  { giorno: 'mar', ora: '13:00', stile: 'iyengar',  tipo: 'Livello 3', insegnante: 'Glenda', durata: '~75 min' },
  { giorno: 'mar', ora: '17:30', stile: 'ashtanga', tipo: 'Mysore',    insegnante: 'Victor', durata: '60-90 min' },
  { giorno: 'mar', ora: '19:00', stile: 'ashtanga', tipo: 'Guidata',   insegnante: 'Victor', durata: '~75 min' },
  // MERCOLEDÌ
  { giorno: 'mer', ora: '7:30',  stile: 'flow',     tipo: 'Vinyasa',   insegnante: 'Giulia', durata: '~60 min' },
  { giorno: 'mer', ora: '8:45',  stile: 'iyengar',  tipo: 'Livello 1', insegnante: 'Glenda', durata: '~75 min' },
  { giorno: 'ven', ora: '17:00', stile: 'teen',     tipo: 'Teen Yoga', insegnante: 'Asia',   durata: '~60 min' },
  { giorno: 'mer', ora: '18:00', stile: 'iyengar',  tipo: 'Livello 2', insegnante: 'Glenda', durata: '~75 min' },
  { giorno: 'mer', ora: '19:30', stile: 'iyengar',  tipo: 'Livello 2', insegnante: 'Glenda', durata: '~75 min' },
  // GIOVEDÌ
  { giorno: 'gio', ora: '13:00', stile: 'iyengar',  tipo: 'Livello 3', insegnante: 'Glenda', durata: '~75 min' },
  { giorno: 'gio', ora: '17:30', stile: 'ashtanga', tipo: 'Mysore',    insegnante: 'Victor', durata: '60-90 min' },
  { giorno: 'gio', ora: '19:00', stile: 'ashtanga', tipo: 'Guidata',   insegnante: 'Victor', durata: '~75 min' },
  // VENERDÌ
  { giorno: 'ven', ora: '7:00',  stile: 'ashtanga', tipo: 'Mysore',    insegnante: 'Victor', durata: '60-90 min' },
  // SABATO
  { giorno: 'sab', ora: '8:30',  stile: 'ashtanga', tipo: 'Mysore',    insegnante: 'Victor', durata: '60-90 min' },
  { giorno: 'sab', ora: '10:30', stile: 'flow',     tipo: 'Vinyasa',   insegnante: 'Giulia', durata: '~60 min' },
  // DOMENICA
  { giorno: 'dom', ora: '17:30', stile: 'flow',     tipo: 'Vinyasa',   insegnante: 'Giulia', durata: '~60 min' },
];

const lezioni = tutteLeLezioni.filter(l => PRATICHE_ATTIVE.includes(STILE_TO_SLUG[l.stile] ?? l.stile));

// Legenda colori: mostra solo stili con lezioni attive
const tuttiStiliLegenda = [
  { stile: 'iyengar', label: 'Iyengar',   color: '#9c9a66' },
  { stile: 'ashtanga', label: 'Ashtanga', color: '#7a6b5f' },
  { stile: 'flow',     label: 'Vinyasa',  color: '#b8a68e' },
  { stile: 'teen',     label: 'Teen Yoga', color: '#d4b5a0' },
];
const legendaAttiva = tuttiStiliLegenda.filter(s => PRATICHE_ATTIVE.includes(STILE_TO_SLUG[s.stile] ?? s.stile));
---

<BaseLayout
  title="Orari · Yoga Tribù"
  description="Una pratica al giorno. Sette giorni su sette. Iyengar e Ashtanga, mattina e sera, a Bassano del Grappa."
>
  <!-- Hero -->
  <Section background="default" size="compact">
    <Container size="narrow" class="text-center pt-8">
      <Tag class="mb-5">Orari</Tag>
      <Heading level={1} class="mb-5">
        Una pratica al giorno.<br/>Sette giorni su sette.
      </Heading>
      <p class="text-text-secondary text-base leading-relaxed max-w-[600px] mx-auto">
        Mattina o sera, tutti i giorni. Trova il tuo orario.
      </p>
    </Container>
  </Section>

  <div class="relative">
    <!-- Filtri -->
    <ScheduleFilters />

    <!-- Griglia desktop -->
    <section class="bg-background-alt py-12 hidden md:block">
      <div class="container-wide">
        <ScheduleGrid lezioni={lezioni} />
      </div>
    </section>

    <!-- Vista mobile -->
    <section class="bg-background-alt py-8 md:hidden">
      <div class="container-default">
        <ScheduleMobile lezioni={lezioni} />
      </div>
    </section>
  </div>

  <!-- Modal lezione -->
  <ScheduleModal />

  <!-- Legenda colori -->
  <section class="bg-background pb-12">
    <div class="container-default flex flex-wrap gap-5">
      {legendaAttiva.map(({ label, color }) => (
        <div class="flex items-center gap-2">
          <span class="w-3 h-3 rounded-full" style={`background: ${color};`}></span>
          <span class="text-small text-text-secondary">{label}</span>
        </div>
      ))}
    </div>
  </section>


  <!-- Non trovi un orario? -->
  <Section background="alt">
    <Container size="narrow" class="text-center">
      <Heading level={2} class="mb-5">Non trovi un orario adatto a te?</Heading>
      <p class="text-text-secondary text-base leading-relaxed mb-10">
        Lavori in orari complicati o cerchi un percorso più personale?
        Le lezioni private si organizzano nei giorni e orari che preferisci tu.
      </p>
      <Button variant="primary" size="md" href="/abbonamenti?tipo=private">Scopri le lezioni private</Button>
    </Container>
  </Section>

  <!-- La tua prima volta -->
  <section class="bg-background py-16 md:py-24">
  <div class="container mx-auto px-6 max-w-[1280px]">

    <!-- Header sezione -->
    <p class="text-xs font-semibold uppercase tracking-[0.1em] text-[#9c9a66] mb-4 text-center">
      LA TUA PRIMA VOLTA
    </p>
    <h2 class="font-serif text-h2-mobile md:text-h2 font-medium text-[#2a2a2a] text-center mb-12 md:mb-16"
        style="font-family: 'New York', serif;">
      Vuoi provare?
    </h2>

    <!-- Tre card -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 max-w-[960px] mx-auto">

      <div class="bg-white border border-[#e8e4df] rounded-[22px] p-8
                  shadow-[0_4px_20px_rgba(0,0,0,0.04)]
                  transition-all duration-[250ms] ease-[cubic-bezier(0.25,0.46,0.45,0.94)]
                  hover:-translate-y-0.5 hover:shadow-[0_8px_28px_rgba(0,0,0,0.06)]">
        <p class="text-xs font-semibold uppercase tracking-[0.1em] text-[#9c9a66] mb-4">01</p>
        <h3 class="font-serif text-xl font-medium text-[#2a2a2a] mb-3"
            style="font-family: 'New York', serif;">
          Scegli la lezione
        </h3>
        <p class="text-sm text-[#6b6b6b] leading-relaxed">
          Guarda gli orari qui sopra e trova la pratica e la fascia oraria che ti interessa.
          Se non sai da dove cominciare, scrivici, ti aiutiamo noi.
        </p>
      </div>

      <div class="bg-white border border-[#e8e4df] rounded-[22px] p-8
                  shadow-[0_4px_20px_rgba(0,0,0,0.04)]
                  transition-all duration-[250ms] ease-[cubic-bezier(0.25,0.46,0.45,0.94)]
                  hover:-translate-y-0.5 hover:shadow-[0_8px_28px_rgba(0,0,0,0.06)]">
        <p class="text-xs font-semibold uppercase tracking-[0.1em] text-[#9c9a66] mb-4">02</p>
        <h3 class="font-serif text-xl font-medium text-[#2a2a2a] mb-3"
            style="font-family: 'New York', serif;">
          Scrivici su WhatsApp
        </h3>
        <p class="text-sm text-[#6b6b6b] leading-relaxed">
          Mandaci un messaggio con la lezione che vuoi provare. Ti confermiamo disponibilità
          e ti diamo tutte le info pratiche. Costa 10€, senza impegno.
        </p>
      </div>

      <div class="bg-white border border-[#e8e4df] rounded-[22px] p-8
                  shadow-[0_4px_20px_rgba(0,0,0,0.04)]
                  transition-all duration-[250ms] ease-[cubic-bezier(0.25,0.46,0.45,0.94)]
                  hover:-translate-y-0.5 hover:shadow-[0_8px_28px_rgba(0,0,0,0.06)]">
        <p class="text-xs font-semibold uppercase tracking-[0.1em] text-[#9c9a66] mb-4">03</p>
        <h3 class="font-serif text-xl font-medium text-[#2a2a2a] mb-3"
            style="font-family: 'New York', serif;">
          Vieni in studio
        </h3>
        <p class="text-sm text-[#6b6b6b] leading-relaxed">
          Tappetino e attrezzi forniti. Vieni con abiti comodi, 15 minuti prima della lezione.
        </p>
      </div>

    </div>

    <!-- CTA -->
    <div class="text-center mt-12">
      <Button variant="primary" size="md" href="https://wa.me/393287675966?text=Ciao%2C+vorrei+prenotare+una+prima+lezione+di+prova" external={true}>
        Prenota su WhatsApp
      </Button>
    </div>

  </div>
</section>

  <!-- CTA finale -->
  <CTAFinal
    headline="Hai trovato la tua lezione?"
    linkLabel="Scrivici su WhatsApp"
    linkHref="https://wa.me/393287675966?text=Ciao!%20Ho%20qualche%20domanda%20sugli%20orari%20di%20Yoga%20Trib%C3%B9."
  />
</BaseLayout>
