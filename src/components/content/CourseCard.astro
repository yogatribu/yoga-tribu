---
interface Props {
  stile: string;
  tagColor: string;
  headline: string;
  descrizione: string;
  bullets: string[];
  link: string;
  image?: string;
  accentColor?: string;
}

const {
  stile,
  tagColor,
  headline,
  descrizione,
  bullets,
  link,
  image = 'https://images.unsplash.com/photo-1599901860904-17e6ed7083a0?w=600&q=80',
  accentColor = '#9c9a66',
} = Astro.props;
---

<a
  href={link}
  class="group block bg-white border border-border overflow-hidden transition-all duration-250 hover:-translate-y-1 hover:shadow-hover"
  style={`--accent: ${accentColor}; border-radius: 22px;`}
>
  <div class="aspect-[4/5] overflow-hidden">
    <img
      src={image}
      alt={stile}
      class="w-full h-full object-cover transition-transform duration-400 group-hover:scale-[1.01]"
      loading="lazy"
    />
  </div>
  <div class="p-8">
    <p
      class="text-[11px] font-semibold uppercase tracking-[0.1em] font-sans mb-3"
      style={`color: ${accentColor};`}
    >
      {stile}
    </p>
    <h3 class="font-serif text-[28px] leading-snug text-text-main mb-4">{headline}</h3>
    <p class="text-text-secondary text-sm leading-relaxed mb-6">{descrizione}</p>
    <div class="border-t border-border pt-5 mb-6 flex flex-col gap-2">
      {bullets.map(b => (
        <p class="text-sm text-text-secondary">· {b}</p>
      ))}
    </div>
    <p class="text-sm font-medium" style={`color: ${accentColor};`}>
      Scopri {stile}
    </p>
  </div>
</a>
