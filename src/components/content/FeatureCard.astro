---
interface Props {
  icon: string;
  title: string;
  body: string;
}

const { icon, title, body } = Astro.props;

// SVG inner content per icon name (Lucide-compatible paths, viewBox 0 0 24 24)
const icons: Record<string, string> = {
  // Iyengar
  HeartPulse: `<path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/><path d="M3.22 12H9.5l1.5-1.5 2 4.5 2-7 1.5 3 .5-1.5 3.22 2.5"/>`,
  Dumbbell:   `<line x1="8" x2="16" y1="12" y2="12"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="12" r="3"/>`,
  Shield:     `<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>`,
  // Ashtanga
  Sunrise:    `<path d="M17 18a5 5 0 0 0-10 0"/><path d="M12 2v9"/><path d="m4.22 10.22 1.42 1.42"/><path d="M2 18h2"/><path d="M20 18h2"/><path d="m19.78 11.64-1.42 1.42"/><path d="m8 6 4-4 4 4"/>`,
  TrendingUp: `<polyline points="23 6 13.5 15.5 8.5 10.5 1 18"/><polyline points="17 6 23 6 23 12"/>`,
  Users:      `<path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>`,
  // Flow
  Wind:       `<path d="M9.59 4.59A2 2 0 1 1 11 8H2m10.59 11.41A2 2 0 1 0 14 16H2m15.73-8.27A2.5 2.5 0 1 1 19.5 12H2"/>`,
  Shuffle:    `<polyline points="16 3 21 3 21 8"/><line x1="4" x2="21" y1="20" y2="3"/><polyline points="21 16 21 21 16 21"/><line x1="15" x2="21" y1="15" y2="21"/><line x1="4" x2="9" y1="4" y2="9"/>`,
  Layers:     `<polygon points="12 2 2 7 12 12 22 7 12 2"/><polyline points="2 17 12 22 22 17"/><polyline points="2 12 12 17 22 12"/>`,
  // Teen
  Smartphone: `<rect height="20" rx="2" ry="2" width="14" x="5" y="2"/><line x1="12" x2="12.01" y1="18" y2="18"/>`,
  BookOpen:   `<path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/>`,
  Smile:      `<circle cx="12" cy="12" r="10"/><path d="M8 13s1.5 2 4 2 4-2 4-2"/><line x1="9" x2="9.01" y1="9" y2="9"/><line x1="15" x2="15.01" y1="9" y2="9"/>`,
  Zap:        `<polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/>`,
  Heart:      `<path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>`,
  // Salute Femminile
  Moon:       `<path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/>`,
  Leaf:       `<path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10Z"/><path d="M2 21c0-3 1.85-5.36 5.08-6C9.5 14.52 12 13 13 12"/>`,
};

const svgContent = icons[icon] ?? `<circle cx="12" cy="12" r="8"/>`;
---

<div class="fc-card">
  <div class="fc-icon">
    <svg
      width="40"
      height="40"
      viewBox="0 0 24 24"
      fill="none"
      stroke="#9c9a66"
      stroke-width="1.5"
      stroke-linecap="round"
      stroke-linejoin="round"
      set:html={svgContent}
    />
  </div>
  <h3 class="fc-title">{title}</h3>
  <p class="fc-body">{body}</p>
</div>

<style>
  .fc-card {
    background: #ffffff;
    border-radius: 18px;
    padding: 40px 32px;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.04);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
    text-align: center;
    transition: transform 250ms ease, box-shadow 250ms ease;
  }

  .fc-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 28px rgba(0, 0, 0, 0.06);
  }

  .fc-icon {
    width: 64px;
    height: 64px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 8px;
    flex-shrink: 0;
  }

  .fc-title {
    font-family: 'New York', Georgia, serif;
    font-size: 22px;
    font-weight: 500;
    color: #2a2a2a;
    line-height: 1.3;
    max-width: 240px;
    margin: 0;
  }

  .fc-body {
    font-family: Inter, sans-serif;
    font-size: 15px;
    font-weight: 400;
    color: #6b6b6b;
    line-height: 1.6;
    max-width: 280px;
    margin: 0;
  }

  @media (max-width: 767px) {
    .fc-card { padding: 32px 24px; }
    .fc-title { font-size: 20px; }
    .fc-body { font-size: 14px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .fc-card { transition: none; }
    .fc-card:hover { transform: none; }
  }
</style>
