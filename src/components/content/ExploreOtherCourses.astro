---
import { PRATICHE_ATTIVE } from '../../config/visibilita.js';
import { altFor } from '../../config/imageAlt.js';

interface Props {
  excludeStile: 'iyengar' | 'ashtanga' | 'flow' | 'teen' | 'donna';
}

const { excludeStile } = Astro.props;

// Mappa id interno → slug in visibilita.js
const ID_TO_SLUG: Record<string, string> = {
  'iyengar': 'iyengar',
  'ashtanga': 'ashtanga',
  'flow': 'vinyasa',
  'teen': 'teen-yoga',
  'donna': 'salute-femminile',
};

const all = [
  {
    id: 'iyengar',
    stile: 'Iyengar Yoga',
    tag: 'PRATICA PRINCIPALE',
    sub: 'Una pratica tradizionale che risolve dolori reali con tecniche precise.',
    href: '/corsi/iyengar',
    foto: '/images/iyengar.webp',
    overlay: 'rgba(0,0,0,0.30)',
  },
  {
    id: 'ashtanga',
    stile: 'Ashtanga Yoga',
    tag: 'PRATICA PRINCIPALE',
    sub: 'Una pratica costante che restituisce silenzio interiore e crescita mentale.',
    href: '/corsi/ashtanga',
    foto: '/images/ashtanga.webp',
    overlay: 'rgba(0,0,0,0.38)',
  },
  {
    id: 'flow',
    stile: 'Vinyasa',
    tag: 'PRATICA COMPLEMENTARE',
    sub: 'Pratica fresca, sempre diversa. Movimento e respiro.',
    href: '/corsi/vinyasa',
    foto: 'https://images.unsplash.com/photo-1518611012118-696072aa579a?w=800&q=80',
    overlay: 'rgba(0,0,0,0.28)',
  },
  {
    id: 'teen',
    stile: 'Teen Yoga',
    tag: 'PRATICA COMPLEMENTARE',
    sub: 'Yoga per ragazzi tra i 12 e i 17 anni.',
    href: '/corsi/teen-yoga',
    foto: 'https://images.unsplash.com/photo-1545205597-3d9d02c29597?w=800&q=80',
    overlay: 'rgba(0,0,0,0.32)',
  },
  {
    id: 'donna',
    stile: 'Salute Femminile',
    tag: 'PRATICA COMPLEMENTARE',
    sub: 'Percorsi per la donna. In ogni fase.',
    href: '/corsi/salute-femminile',
    foto: '/images/salute_femminile.webp',
    overlay: 'rgba(0,0,0,0.30)',
  },
];

const shown = all
  .filter(c => c.id !== excludeStile && PRATICHE_ATTIVE.includes(ID_TO_SLUG[c.id] ?? c.id))
  .slice(0, 2);
---

<section class="bg-background py-16 md:py-24">
  <div class="container-default">
    <h2 class="font-serif text-h2-mobile md:text-h2 text-text-main mb-12">
      Esplora le altre pratiche.
    </h2>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      {shown.map(({ stile, tag, sub, href, foto, overlay }) => (
        <a
          href={href}
          class="explore-card group relative overflow-hidden rounded-[22px]"
          style="height: 480px; display: block;"
        >
          <img
            src={foto}
            alt={altFor(foto, stile)}
            class="absolute inset-0 w-full h-full object-cover transition-transform duration-[400ms] ease-[cubic-bezier(0.25,0.46,0.45,0.94)] group-hover:scale-[1.01]"
            loading="lazy"
          />
          <div class="absolute inset-0" style={`background: ${overlay};`}></div>
          <div class="absolute inset-0 flex flex-col justify-end p-10">
            <h2 class="font-serif text-[36px] text-white leading-tight mb-3">{stile}</h2>
            <p class="text-white/80 text-[15px] leading-relaxed mb-6 max-w-[200px]">{sub}</p>
            <span class="inline-flex items-center justify-center bg-primary text-white text-sm font-medium px-6 py-3 rounded-full w-fit transition-colors hover:bg-[#8a885a]">
              Scopri
            </span>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .explore-card {
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.08);
    transition: box-shadow 400ms cubic-bezier(0.25, 0.46, 0.45, 0.94);
    text-decoration: none;
  }
  .explore-card:hover {
    box-shadow: 0 24px 48px rgba(0, 0, 0, 0.15);
  }
</style>
