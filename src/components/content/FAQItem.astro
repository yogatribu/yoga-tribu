---
interface Props {
  question: string;
  answer: string;
}
const { question, answer } = Astro.props;
---

<details class="faq-item">
  <summary class="faq-summary">
    <span class="faq-icon" aria-hidden="true">+</span>
    <span class="faq-question">{question}</span>
  </summary>
  <div class="faq-answer" set:html={answer} />
</details>

<style is:global>
  /* ── FAQ Item ── */
  .faq-item {
    background: white;
    border: 1px solid #e8e4df;
    border-radius: 20px;
    overflow: hidden;
    transition: border-color 200ms ease-out, box-shadow 200ms ease-out;
  }

  .faq-item:hover {
    border-color: #d4cfc7;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.03);
  }

  .faq-item[open] {
    border-color: #9c9a66;
    background: #fdfbf8;
  }

  .faq-summary {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 24px;
    cursor: pointer;
    list-style: none;
    user-select: none;
    -webkit-user-select: none;
  }

  .faq-summary::-webkit-details-marker {
    display: none;
  }

  .faq-summary:focus-visible {
    outline: 2px solid #9c9a66;
    outline-offset: -2px;
    border-radius: 20px;
  }

  .faq-icon {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 24px;
    height: 24px;
    font-size: 24px;
    font-weight: 300;
    font-family: Inter, system-ui, sans-serif;
    color: #9c9a66;
    line-height: 1;
    transition: transform 300ms cubic-bezier(0.65, 0, 0.35, 1);
  }

  .faq-item[open] .faq-icon {
    transform: rotate(45deg);
  }

  .faq-question {
    font-family: Inter, sans-serif;
    font-size: 16px;
    font-weight: 600;
    color: #2a2a2a;
    line-height: 1.4;
    flex: 1;
  }

  .faq-answer {
    padding: 0 24px 24px 64px; /* 24 padding + 24 icon + 16 gap = 64 */
    font-family: Inter, sans-serif;
    font-size: 15px;
    font-weight: 400;
    line-height: 1.6;
    color: #4a4a4a;
  }

  .faq-answer p {
    margin: 0 0 12px;
  }

  .faq-answer p:last-child {
    margin-bottom: 0;
  }

  /* ── FAQ Container ── */
  .faq-section {
    padding: 96px 24px;
    background: #f9f5f0;
  }

  .faq-container {
    max-width: 760px;
    margin: 0 auto;
  }

  .faq-title {
    font-family: 'New York', Georgia, serif;
    font-size: 36px;
    font-weight: 400;
    color: #2a2a2a;
    text-align: center;
    margin-bottom: 48px;
    line-height: 1.2;
  }

  .faq-list {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  /* ── Responsive ── */
  @media (max-width: 768px) {
    .faq-summary {
      padding: 20px;
      gap: 12px;
    }
    .faq-question {
      font-size: 15px;
    }
    .faq-answer {
      padding: 0 20px 20px 56px;
    }
    .faq-section {
      padding: 64px 16px;
    }
    .faq-title {
      font-size: 28px;
      margin-bottom: 32px;
    }
  }

  /* ── Reduced motion ── */
  @media (prefers-reduced-motion: reduce) {
    .faq-icon { transition: none; }
    .faq-item { transition: none; }
  }
</style>
