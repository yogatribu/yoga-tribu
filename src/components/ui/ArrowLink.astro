---
interface Props {
  href: string;
  external?: boolean;
  tone?: 'ocra' | 'light';
}
const { href, external = false, tone = 'ocra' } = Astro.props;
---

<a
  href={href}
  class={`arrow-link arrow-link--${tone}`}
  {...(external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
>
  <span class="link-text"><slot /></span>
  <span class="link-arrow">&rsaquo;</span>
</a>

<style>
.arrow-link {
  display: inline-flex;
  align-items: center;
  gap: 4px;
  text-decoration: none;
  font-family: Inter, sans-serif;
  font-size: 14px;
  font-weight: 400;
  cursor: pointer;
}
.arrow-link--ocra { color: #9c9a66; }
.arrow-link--light {
  color: rgba(255, 255, 255, 0.8);
  transition: color 100ms ease-out;
}
.arrow-link--light:hover { color: rgba(255, 255, 255, 1); }

.arrow-link .link-text {
  text-decoration: underline;
  text-underline-offset: 2px;
  text-decoration-color: transparent;
  transition: text-decoration-color 100ms ease-out;
}
.arrow-link:hover .link-text {
  text-decoration-color: currentColor;
}
.arrow-link .link-arrow {
  text-decoration: none !important;
}
</style>
